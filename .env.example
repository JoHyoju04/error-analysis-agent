# ---------------------------------------------------------------------------
# error-analysis-agent 설정 예제. `cp .env.example .env` 후 실제 값으로 채운다.
# .env 는 절대 Git 에 commit 하지 않는다 (.gitignore 에 포함되어 있다).
# ---------------------------------------------------------------------------

# --- Slack -----------------------------------------------------------------
# Socket Mode 용 App-Level Token (connections:write)
SLACK_APP_TOKEN=xapp-REPLACE_ME
# Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
# 명령을 허용할 채널 ID 목록 (쉼표 구분). 비어 있으면 모든 명령을 거부한다.
SLACK_ALLOWED_CHANNEL_IDS=C000000001
# 명령을 허용할 사용자 ID 목록 (쉼표 구분). 비어 있으면 모든 명령을 거부한다(기본 거부).
SLACK_ALLOWED_USER_IDS=U000000001
# 트리거 명령어. 스레드 답글이 이 문자열과 정확히 일치할 때만 분석을 시작한다.
SLACK_COMMAND=!AI분석
# Slack 메시지 1건당 최대 문자 수. 초과 시 같은 스레드에 여러 답글로 분할한다.
SLACK_MAX_MESSAGE_CHARS=3500

# --- Sentry (Cloud 또는 Self-Hosted) ---------------------------------------
SENTRY_BASE_URL=https://sentry.example.com
SENTRY_ORG=my-org
# event:read 권한 토큰
SENTRY_AUTH_TOKEN=REPLACE_ME
SENTRY_TIMEOUT_SECONDS=15
SENTRY_MAX_RETRIES=3
# Slack 링크에서 추가로 신뢰할 Sentry 호스트 (쉼표 구분, 보통 비워 둔다).
# SENTRY_BASE_URL 의 호스트는 항상 허용된다. 그 밖의 호스트는 SSRF 방지를 위해 거부한다.
SENTRY_EXTRA_ALLOWED_HOSTS=

# --- Codex / ChatGPT OAuth -------------------------------------------------
# 인증은 ChatGPT 계정 로그인(OAuth)만 사용한다. 사용량은 ChatGPT 플랜에 포함된
# 분량에서 차감되므로 별도 과금이 없고, OpenAI API Key 는 쓰지 않는다.
# OPENAI_API_KEY / CODEX_API_KEY 는 여기에 넣지 말 것. 봇이 Codex 런타임에
# 넘기는 환경에서 두 변수를 빈 값으로 덮어쓰므로 설정해도 무시된다.
#
# OAuth 세션(auth.json)이 저장되는 디렉터리. 쓰기 가능한 비공개 볼륨이어야 한다.
CODEX_HOME=/home/bot/.codex
# 비워 두면 ChatGPT 계정의 기본 모델을 사용한다.
CODEX_MODEL=
# Sentry 데이터를 Codex 에 넘기는 방식: external_message(권장) 또는 inline
CODEX_UNTRUSTED_INPUT_MODE=external_message
# 추론 강도: none | minimal | low | medium | high | xhigh | max | ultra
# 비워 두면 모델의 기본 강도를 쓴다(빈 값과 "none" 은 다르다). 모델마다 지원 범위가
# 달라서, 지원하지 않는 값은 런타임이 거부할 수 있다. 장애 분석은 저장소를 탐색하는
# 작업이라 high 가 품질에 유리하지만 그만큼 사용량을 더 쓴다.
CODEX_REASONING_EFFORT=

# --- Worker / 분석 ---------------------------------------------------------
ANALYSIS_MAX_PARALLEL=2
ANALYSIS_TIMEOUT_SECONDS=300
# true 면 배포 revision(Commit SHA)을 확인하지 못했을 때 분석을 중단한다(fail-closed).
ANALYSIS_REQUIRE_RELEASE_REVISION=true
# Codex 프롬프트에 넣는 정제된 Sentry 컨텍스트의 최대 바이트 수
ANALYSIS_MAX_CONTEXT_BYTES=30000
# 분석용 소스 스냅샷을 만드는 디렉터리 (쓰기 가능해야 한다)
ANALYSIS_SNAPSHOT_ROOT=/workspace/snapshots
# revision 이 로컬에 없을 때 `git fetch` 를 허용할지 여부
ANALYSIS_ALLOW_FETCH=true
# AGENTS.md 선택 정책: prefer_repo(저장소 파일 우선) 또는 always_template
ANALYSIS_AGENTS_MD_POLICY=prefer_repo

# --- 기타 -----------------------------------------------------------------
# Sentry 프로젝트 ↔ Git 저장소 매핑 파일
CONFIG_PATH=/app/config.yaml
# 처리한 Slack event_id 를 저장해 재시작 후에도 중복 실행을 막는다. 비우면 메모리만 사용.
STATE_DB_PATH=/workspace/state/jobs.sqlite3
LOG_LEVEL=INFO
